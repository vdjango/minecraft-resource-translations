[Unit]
Description=Buggcraft resource translation platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=buggtranslate
Group=buggtranslate
WorkingDirectory=/opt/buggcraft-translation/current
EnvironmentFile=/etc/buggcraft-translation.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/buggcraft-translation/venv/bin/mc-translate
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
StateDirectory=buggcraft-translation
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/buggcraft-translation
MemoryMax=512M
TasksMax=128
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
