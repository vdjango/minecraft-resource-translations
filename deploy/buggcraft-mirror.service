[Unit]
Description=Buggcraft independent Minecraft resource cache
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=buggcraft-translation
WorkingDirectory=/opt/buggcraft-translation
Environment=TRANSLATION_ENV_FILE=/etc/buggcraft-translation.env
Environment=TRANSLATION_MIRROR_ROOT=/var/lib/buggcraft-translation/mirror
ExecStart=/opt/buggcraft-translation/venv/bin/python -m mc_translate.mirror
Restart=on-failure
RestartSec=5
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryHigh=512M
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/buggcraft-translation
UMask=0077

[Install]
WantedBy=multi-user.target
